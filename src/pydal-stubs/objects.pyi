class Expression:
    """A SQL expression. Comparisons build `Query` objects rather than booleans."""

    _dialect_expressions_: dict[str, Any]
    db: DAL
    op: Any
    first: Any
    second: Any
    type: Any
    tablename: str | None
    _table: Table | None
    _itype: str | None
    optional_args: dict[str, Any]

    @property
    def _dialect(self) -> Any: ...
    def __init__(
        self,
        db: DAL,
        op: Any,
        first: Any = ...,
        second: Any = ...,
        type: Any = ...,
        tablename: str | None = ...,
        **optional_args: Any,
    ) -> None: ...
    def sum(self) -> Expression: ...
    def max(self) -> Expression: ...
    def min(self) -> Expression: ...
    def len(self) -> Expression: ...
    def avg(self) -> Expression: ...
    def abs(self) -> Expression: ...
    def cast(self, cast_as: Any, **kwargs: Any) -> Expression: ...
    def lower(self) -> Expression: ...
    def upper(self) -> Expression: ...
    def replace(self, a: Any, b: Any) -> Expression: ...
    def year(self) -> Expression: ...
    def month(self) -> Expression: ...
    def day(self) -> Expression: ...
    def hour(self) -> Expression: ...
    def minutes(self) -> Expression: ...
    def seconds(self) -> Expression: ...
    def epoch(self) -> Expression: ...
    def coalesce(self, *others: Any) -> Expression: ...
    def coalesce_zero(self) -> Expression: ...
    def __getitem__(self, i: int | slice) -> Expression: ...
    def __or__(self, other: Any) -> Expression: ...
    def __invert__(self) -> Expression: ...
    def __add__(self, other: Any) -> Expression: ...
    def __radd__(self, other: Any) -> Expression: ...
    def __sub__(self, other: Any) -> Expression: ...
    def __mul__(self, other: Any) -> Expression: ...
    def __div__(self, other: Any) -> Expression: ...
    def __truediv__(self, other: Any) -> Expression: ...
    def __mod__(self, other: Any) -> Expression: ...
    # Comparison operators are overloaded to build queries; this deliberately
    # departs from `object.__eq__`, matching pyDAL's runtime behavior.
    def __eq__(self, value: Any) -> Query: ...  # type: ignore[override]
    def __ne__(self, value: Any) -> Query: ...  # type: ignore[override]
    def __lt__(self, value: Any) -> Query: ...
    def __le__(self, value: Any) -> Query: ...
    def __gt__(self, value: Any) -> Query: ...
    def __ge__(self, value: Any) -> Query: ...
    def __hash__(self) -> int: ...
    def like(self, value: Any, case_sensitive: bool = ..., escape: str | None = ...) -> Query: ...
    def ilike(self, value: Any, escape: str | None = ...) -> Query: ...
    def regexp(self, value: Any, match_parameter: Any = ...) -> Query: ...
    def belongs(self, *value: Any, **kwattr: Any) -> Query: ...
    def startswith(self, value: Any) -> Query: ...
    def endswith(self, value: Any) -> Query: ...
    def contains(self, value: Any, all: bool = ..., case_sensitive: bool = ...) -> Query: ...
    def with_alias(self, alias: str) -> Expression: ...
    def st_asgeojson(self, precision: int = ..., options: int = ...) -> Expression: ...
    def st_astext(self) -> Expression: ...
    def st_aswkb(self) -> Expression: ...
    def st_x(self) -> Expression: ...
    def st_y(self) -> Expression: ...
    def st_distance(self, other: Any) -> Expression: ...
    def st_simplify(self, value: Any) -> Expression: ...
    def st_simplifypreservetopology(self, value: Any) -> Expression: ...
    def st_transform(self, value: Any) -> Expression: ...
    def st_contains(self, value: Any) -> Query: ...
    def st_equals(self, value: Any) -> Query: ...
    def st_intersects(self, value: Any) -> Query: ...
    def st_overlaps(self, value: Any) -> Query: ...
    def st_touches(self, value: Any) -> Query: ...
    def st_within(self, value: Any) -> Query: ...
    def st_dwithin(self, value: Any, distance: Any) -> Query: ...
    def json_key(self, key: str) -> Expression: ...
    def json_key_value(self, key: str) -> Expression: ...
    def json_path(self, path: str) -> Expression: ...
    def json_path_value(self, path: str) -> Expression: ...
    def json_contains(self, jsonvalue: Any) -> Query: ...

