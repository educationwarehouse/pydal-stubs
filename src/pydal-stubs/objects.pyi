    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def __getitem__(self, k: Any) -> Any: ...
    def __setitem__(self, key: Any, value: Any) -> None: ...
    def __getattr__(self, k: str) -> Any: ...
    def __contains__(self, k: Any) -> bool: ...
    def __int__(self) -> int: ...
    def __long__(self) -> int: ...
    def __hash__(self) -> int: ...
    def __call__(self, k: Any) -> Any: ...
    def __copy__(self) -> Row: ...
    def __eq__(self, other: object) -> bool: ...
    def get(self, key: Any, default: Any = ...) -> Any: ...
    def as_dict(
        self,
        datetime_to_str: bool = ...,
        custom_types: type[Any] | Iterable[type[Any]] | None = ...,
    ) -> dict[str, Any]: ...
    def as_xml(
        self, row_name: str = ..., colnames: Sequence[str] | None = ..., indent: str = ...
    ) -> str: ...
    def as_json(
        self,
        mode: str = ...,
        default: Callable[[Any], Any] | None = ...,
        colnames: Sequence[str] | None = ...,
        serialize: bool = ...,
        **kwargs: Any,
    ) -> Any: ...

def pickle_row(s: Row) -> tuple[Any, ...]: ...

class Table(Serializable, BasicStorage):
    """
    A defined table. Unknown attributes resolve to the table's `Field`s, which is
    how `db.person.name` works at runtime.
    """

    _db: DAL
    _tablename: str
    _actual_tablename: str
    _rname: str
    _raw_rname: str
    _sequence_name: str
    _trigger_name: str
    _common_filter: Callable[..., Any] | None
    _format: str | Callable[[Row], str] | None
    _singular: str
    _plural: str
    _primarykey: list[str]
    _fields: SQLCallableList
    _id: Field
    _before_insert: list[Callable[[OpRow], Any]]
    _after_insert: list[Callable[[OpRow, Any], Any]]
    _before_update: list[Callable[[Set, OpRow], Any]]
    _after_update: list[Callable[[Set, OpRow], Any]]
    _before_delete: list[Callable[[Set], Any]]
    _after_delete: list[Callable[[Set], Any]]
    ALL: SQLALL
    virtualfields: list[Any]
    add_method: MethodAdder
    _actual: bool
    _dalname: str
    _migrate: bool | str | None
    _references: list[Field]
    _referenced_by: list[Field]
    _referenced_by_list: list[Field]
    _virtual_fields: list[Any]
    _virtual_methods: list[Any]

    def __init__(
        self, db: DAL, tablename: str, *fields: Field | Table | str, **args: Any
    ) -> None: ...
    @property
    def fields(self) -> SQLCallableList: ...
    # Unknown attributes are the table's columns; see also `__getitem__`.
    def __getattr__(self, key: str) -> Field: ...
    @overload
    def __getitem__(self, key: str) -> Field: ...
    @overload
    def __getitem__(self, key: int) -> Row | None: ...
    @overload
    def __getitem__(self, key: Mapping[str, Any]) -> Row | None: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __call__(self, key: Any = ..., **kwargs: Any) -> Row | None: ...
    # pyDAL iterates a table's fields, not the mapping keys `BasicStorage` yields.
    def __iter__(self) -> Iterator[Field]: ...  # type: ignore[override]
    def __str__(self) -> str: ...
    @property
    def sqlsafe(self) -> str: ...
    @property
    def sqlsafe_alias(self) -> str: ...
    @property
    def sql_shortref(self) -> str: ...
    @property
    def sql_fullref(self) -> str: ...
    @property
    def _structure(self) -> Any: ...
    def _filter_fields_for_operation(self, fields: Any) -> list[tuple[Field, Any]]: ...
    def _compute_fields_for_operation(
        self, fields: Any, to_compute: Any
    ) -> OpRow: ...
    def _fields_and_values_for_insert(self, fields: Any) -> OpRow: ...
    def _fields_and_values_for_update(self, fields: Any) -> OpRow: ...
    def query_name(self, *args: Any, **kwargs: Any) -> tuple[str, ...]: ...
    def update(self, *args: Any, **kwargs: Any) -> None: ...
    def _drop(self, mode: str = ...) -> str: ...
    def drop(self, mode: str = ...) -> None: ...
    def _truncate(self, mode: str = ...) -> str: ...
    def _insert(self, **fields: Any) -> str: ...
    def _validate(self, **vars: Any) -> dict[str, Any]: ...
    def _build_query(self, key: Mapping[str, Any]) -> Query | None: ...
    def _filter_fields(
        self, record: Any, allow_id: bool = ..., writable_only: bool = ...
    ) -> dict[str, Any]: ...
    # `record` is duck-typed: pyDAL only ever calls `record.get("id")` on it, so
    # ORM row wrappers are legitimate here.
    def _validate_fields(
        self, fields: Mapping[str, Any], record: Any = ...
    ) -> tuple[dict[str, Any], dict[str, Any]]: ...
    def _create_references(self) -> None: ...
    def _enable_record_versioning(
        self,
        archive_db: DAL | None = ...,
        archive_name: str = ...,
        is_active: str = ...,
        current_record: str = ...,
        current_record_label: str | None = ...,
        migrate: Any = ...,
        redefine: Any = ...,
    ) -> None: ...
    def _upload_fieldnames(self) -> set[str]: ...
    def truncate(self, mode: str = ...) -> None: ...
    # Returns the new row id. pyDAL hands back a `Reference` bound to this table,
    # except when a `_before_insert` callback aborts the insert and `0` is returned.
    def insert(self, **fields: Any) -> Reference: ...
    def bulk_insert(self, items: Iterable[Mapping[str, Any]]) -> list[Reference]: ...
    def validate_and_insert(self, **fields: Any) -> dict[str, Any]: ...
    def validate_and_update(self, _key: Any, **fields: Any) -> dict[str, Any]: ...
    def update_or_insert(self, _key: Any = ..., **values: Any) -> Reference | None: ...
    def validate_and_update_or_insert(
        self, _key: Any = ..., **fields: Any
    ) -> dict[str, Any]: ...
    def import_from_csv_file(
        self,
        csvfile: Any,
        id_map: Mapping[str, Any] | None = ...,
        null: str = ...,
        unique: str = ...,
        id_offset: Mapping[str, Any] | None = ...,
        transform: Callable[[Any], Any] | None = ...,
        validate: bool = ...,
        encoding: str = ...,
        **kwargs: Any,
    ) -> Any: ...
    def as_dict(self, flat: bool = ..., sanitize: bool = ...) -> dict[str, Any]: ...
    def with_alias(self, alias: str) -> Table: ...
    def on(self, query: Query | Expression | bool) -> Expression: ...
    def create_index(self, name: str, *fields: Field | str, **kwargs: Any) -> Any: ...
    def drop_index(self, name: str, if_exists: bool = ...) -> Any: ...

